{
  "name": "standoffx-menu",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone responsive StandoffX menu prototype",
  "main": "electron.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.softer.standoffx.menu",
    "productName": "StandoffX Menu",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StandoffX Menu"
    }
  }
}
