{
  "name": "standoffx-menu",
  "version": "0.2.0",
  "private": true,
  "description": "StandoffX menu prototype with MongoDB backend and tester mode",
  "main": "electron.cjs",
  "scripts": {
    "server": "node server.js",
    "dev": "node server.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.softer.standoffx.menu",
    "productName": "StandoffX Menu",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "server.js",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StandoffX Menu"
    },
    "artifactName": "${productName}-Setup.${ext}"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  }
}
