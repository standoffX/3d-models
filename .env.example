# Copy this file to .env and set your MongoDB Atlas connection string.
# Never commit a real .env file or database password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/standoffx?retryWrites=true&w=majority
PORT=3000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret-before-deploy
ADMIN_NICK=SofterX
# First-start bootstrap password; change it in production Environment before deployment.
ADMIN_PASSWORD=SofterX
